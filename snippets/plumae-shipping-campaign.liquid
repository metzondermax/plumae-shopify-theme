{% liquid
  assign offer_scope = placement | default: 'product'
  assign campaign_now = 'now' | date: '%s' | plus: 0
  assign campaign_start = 1792393200
  assign campaign_end = 1792958400
  assign campaign_active = false
  if campaign_now >= campaign_start and campaign_now < campaign_end
    assign campaign_active = true
  endif
  if request.design_mode
    assign campaign_active = true
  endif
%}
{% if offer_scope == 'announcement' %}
  <span data-pl-shipping-offer {% unless campaign_active %}hidden{% endunless %}>Deze week: gratis verzending op de basisset in Nederland en België</span>
  <span data-pl-shipping-default {% if campaign_active %}hidden{% endif %}>{{ fallback_text }}</span>
{% elsif promo_product.handle == 'wat-eten-we-vandaag-basisset' %}
  {% if offer_scope == 'hero' %}
    <p class="pl-redesign-hero__offer" data-pl-shipping-offer {% unless campaign_active %}hidden{% endunless %}>Deze week: gratis verzending op de basisset in Nederland en België</p>
  {% else %}
    <aside class="pl-shipping-offer pl-shipping-offer--{{ offer_scope }}" data-pl-shipping-offer {% unless campaign_active %}hidden{% endunless %}>
      <p class="pl-shipping-offer__eyebrow">Actieweek · t/m zondag 21:00 uur</p>
      <h3 class="pl-shipping-offer__title">Basisset voor {{ promo_product.price | money }} <strong>+ gratis verzending</strong></h3>
      <p class="pl-shipping-offer__copy">Bestel de basisset met gratis verzending in Nederland en België. Je ziet de verzendkostenkorting bij het afrekenen.</p>
    </aside>
  {% endif %}
{% endif %}
