{%- liquid
  assign offer_product = promo_product
  assign offer_scope = placement | default: 'product'
-%}
{%- if offer_product.handle == 'wat-eten-we-vandaag-basisset' and offer_product.price == 1995 -%}
  <aside class="pl-bundle-offer pl-bundle-offer--{{ offer_scope }}" data-pl-bundle-offer hidden>
    <p class="pl-bundle-offer__eyebrow">Tijdelijke actie</p>
    <h3 class="pl-bundle-offer__title">Basisset + 1 uitbreiding <strong>voor €24,95</strong></h3>
    <p class="pl-bundle-offer__copy">Kies zelf Budget, Gezond of Pasta. De €5 bundelkorting wordt automatisch in de winkelwagen verrekend.</p>
    {%- if offer_scope == 'product' -%}
      <p class="pl-bundle-offer__instruction">Voeg de basisset toe en kies daarna je uitbreiding:</p>
      <nav class="pl-bundle-offer__choices" aria-label="Kies een uitbreiding">
        <a href="/products/wat-eten-we-vandaag-budget-uitbreiding">Budget</a>
        <a href="/products/wat-eten-we-vandaag-gezond-uitbreiding">Gezond</a>
        <a href="/products/wat-eten-we-vandaag-pasta-uitbreiding">Pasta</a>
      </nav>
    {%- else -%}
      <a class="pl-bundle-offer__link" href="{{ offer_product.url }}">Kies je uitbreiding <span aria-hidden="true">→</span></a>
    {%- endif -%}
  </aside>
{%- endif -%}
