{% liquid
  assign manual_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign manual_count = manual_count | plus: 1
    endif
  endfor
%}

<section class="plumae-section plumae-carousel-section" style="--carousel-bg: {{ section.settings.background_color }}; --carousel-text: {{ section.settings.text_color }}; --card-bg: {{ section.settings.card_background }}; --card-text: {{ section.settings.card_text_color }};">
  <div class="plumae-shell">
    <div class="plumae-carousel__header">
      <div class="plumae-carousel__copy">
        <h2 class="plumae-section__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<div class="plumae-rte">{{ section.settings.text }}</div>{% endif %}
      </div>
      <div class="plumae-carousel__controls">
        <button type="button" class="plumae-carousel__arrow" aria-label="Vorige producten" onclick="document.getElementById('PlumaeCarousel-{{ section.id }}').scrollBy({left:-360,behavior:'smooth'})">‹</button>
        <button type="button" class="plumae-carousel__arrow" aria-label="Volgende producten" onclick="document.getElementById('PlumaeCarousel-{{ section.id }}').scrollBy({left:360,behavior:'smooth'})">›</button>
      </div>
    </div>

    <div class="plumae-carousel" id="PlumaeCarousel-{{ section.id }}">
      {% if manual_count > 0 %}
        {% for block in section.blocks %}
          {% assign item_product = block.settings.product %}
          {% if item_product != blank %}
            {% assign item_alt = item_product.featured_image.alt | default: item_product.title %}
            <a class="plumae-product-card" href="{{ item_product.url }}" {{ block.shopify_attributes }}>
              <div class="plumae-product-card__media">
                {% if item_product.featured_image != blank %}
                  {{ item_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 990px) 31vw, 84vw', alt: item_alt }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <h3 class="plumae-product-card__title">{{ item_product.title }}</h3>
              <p class="plumae-product-card__price">{{ item_product.price | money }}</p>
            </a>
          {% endif %}
        {% endfor %}
      {% elsif section.settings.collection != blank and section.settings.collection.products_count > 0 %}
        {% for item_product in section.settings.collection.products limit: section.settings.max_products %}
          {% assign item_alt = item_product.featured_image.alt | default: item_product.title %}
          <a class="plumae-product-card" href="{{ item_product.url }}">
            <div class="plumae-product-card__media">
              {% if item_product.featured_image != blank %}
                {{ item_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 990px) 31vw, 84vw', alt: item_alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <h3 class="plumae-product-card__title">{{ item_product.title }}</h3>
            <p class="plumae-product-card__price">{{ item_product.price | money }}</p>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="plumae-product-card">
            <div class="plumae-product-card__placeholder">Selecteer uitbreiding {{ i }} in de thema-editor</div>
            <h3 class="plumae-product-card__title">Uitbreidingsset {{ i }}</h3>
            <p class="plumae-product-card__price">Binnenkort beschikbaar</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Plumae: carrousel",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Ontdek de uitbreidingssets" },
    { "type": "richtext", "id": "text", "label": "Toelichting", "default": "<p>Breid het spel uit met nieuwe gerechten en mogelijkheden.</p>" },
    { "type": "collection", "id": "collection", "label": "Collectie als automatische bron" },
    { "type": "range", "id": "max_products", "label": "Maximum aantal producten", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "color", "id": "background_color", "label": "Achtergrond carrousel", "default": "#475A61" },
    { "type": "color", "id": "text_color", "label": "Tekstkleur carrousel", "default": "#F1EADA" },
    { "type": "color", "id": "card_background", "label": "Achtergrond productkaarten", "default": "#F1EADA" },
    { "type": "color", "id": "card_text_color", "label": "Tekstkleur productkaarten", "default": "#475A61" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Handmatig product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    }
  ],
  "presets": [{
    "name": "Plumae: carrousel",
    "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }]
  }]
}
{% endschema %}
