{% liquid
  assign featured_product = section.settings.product
  assign featured_alt = featured_product.featured_image.alt | default: featured_product.title
  assign placeholder_alt = section.settings.placeholder_image.alt | default: section.settings.heading
%}
<section class="plumae-section plumae-featured" style="--featured-bg: {{ section.settings.background_color }};">
  <div class="plumae-shell plumae-featured__grid">
    <div class="plumae-featured__media">
      {% if featured_product != blank and featured_product.featured_image != blank %}
        <a href="{{ featured_product.url }}" aria-label="{{ featured_product.title | escape }}">
          {{ featured_product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 58vw, 100vw', alt: featured_alt }}
        </a>
      {% elsif section.settings.placeholder_image != blank %}
        {{ section.settings.placeholder_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 58vw, 100vw', alt: placeholder_alt }}
      {% else %}
        <img src="{{ 'plumae-basisbox-placeholder.png' | asset_url }}" width="1280" height="1280" loading="lazy" alt="Voorbeeldafbeelding van de basisset">
      {% endif %}
    </div>
    <div class="plumae-featured__content">
      {% if section.settings.label != blank %}<p class="plumae-featured__label">{{ section.settings.label }}</p>{% endif %}
      <h2 class="plumae-featured__title">{% if featured_product != blank %}{{ featured_product.title }}{% else %}{{ section.settings.heading }}{% endif %}</h2>
      {% if featured_product != blank %}
        <p class="plumae-featured__price">{{ featured_product.price | money }}</p>
        {% if section.settings.show_description and featured_product.description != blank %}<div class="plumae-featured__description plumae-rte">{{ featured_product.description | strip_html | truncatewords: 45 }}</div>{% endif %}
        <a class="plumae-button plumae-button--filled" href="{{ featured_product.url }}">{{ section.settings.button_label }}</a>
      {% else %}
        <div class="plumae-featured__description plumae-rte">{{ section.settings.placeholder_text }}</div>
        <a class="plumae-button plumae-button--filled" href="{{ section.settings.placeholder_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {% if request.design_mode %}<p><small>Selecteer hier in de thema-editor de basisset als product.</small></p>{% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Plumae: hoofdproduct",
  "settings": [
    { "type": "product", "id": "product", "label": "Hoofdproduct (basisset)" },
    { "type": "image_picker", "id": "placeholder_image", "label": "Tijdelijke afbeelding" },
    { "type": "text", "id": "label", "label": "Bovenregel", "default": "De basisset" },
    { "type": "text", "id": "heading", "label": "Tijdelijke productnaam", "default": "Wat eten we vandaag? – Basisset" },
    { "type": "richtext", "id": "placeholder_text", "label": "Tijdelijke producttekst", "default": "<p>Maak in vijf minuten samen een weekmenu. Selecteer later het echte product in de thema-editor.</p>" },
    { "type": "checkbox", "id": "show_description", "label": "Productomschrijving tonen", "default": true },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Bekijk de basisset" },
    { "type": "url", "id": "placeholder_link", "label": "Tijdelijke knoplink" },
    { "type": "color", "id": "background_color", "label": "Achtergrondkleur", "default": "#F1EADA" }
  ],
  "presets": [{ "name": "Plumae: hoofdproduct" }]
}
{% endschema %}
