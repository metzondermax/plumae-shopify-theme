{% liquid
  assign featured_product = section.settings.product
  assign variant = featured_product.selected_or_first_available_variant
  assign product_form_id = 'PlumaeHomeProduct-' | append: section.id
  assign featured_image = section.settings.image | default: featured_product.featured_image
%}
<section class="pl-redesign-product{% if template.name == 'collection' %} pl-redesign-product--collection{% endif %}" id="basisset">
  <div class="plumae-shell pl-redesign-product__inner">
    <div class="pl-redesign-product__visual plumae-reveal">
      <span class="pl-redesign-product__badge">Bestseller</span>
      {% if featured_image != blank %}
        {% assign featured_alt = featured_image.alt | default: 'Wat eten we vandaag? Basisset' %}
        {{ featured_image | image_url: width: 1100 | image_tag: class: 'pl-redesign-product__box', loading: 'lazy', widths: '320, 480, 720, 1100', sizes: '(min-width: 750px) 45vw, 90vw', alt: featured_alt }}
      {% else %}
        <img class="pl-redesign-product__box" src="{{ 'basisset_3d_e2947c8a-7167-4929-a452-8d773504c1d4.png' | file_url }}" width="1254" height="1254" loading="lazy" alt="Wat eten we vandaag? Basisset">
      {% endif %}
      {% if template.name == 'index' %}
        <img class="pl-redesign-product__groente" src="{{ 'groentemannetje.png' | file_url }}" width="510" height="560" loading="lazy" alt="">
        <img class="pl-redesign-product__effect pl-redesign-product__effect--left" src="{{ 'effect_1.png' | file_url }}" width="150" height="150" loading="lazy" alt="">
        <img class="pl-redesign-product__effect pl-redesign-product__effect--right" src="{{ 'effect_2.png' | file_url }}" width="150" height="150" loading="lazy" alt="">
      {% endif %}
    </div>
    <div class="pl-redesign-product__content plumae-reveal">
      <p class="pl-redesign-product__label">{{ section.settings.label }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="pl-redesign-product__cards">46 gerechtenkaarten <span aria-hidden="true">|</span> 24 actiekaarten</p>
      <p class="pl-redesign-product__price">
        {% if featured_product != blank %}
          {% if featured_product.compare_at_price > featured_product.price %}<s>{{ featured_product.compare_at_price | money }}</s>{% endif %}
          <strong>{{ featured_product.price | money }}</strong>
        {% else %}<span>Prijs wordt getoond zodra de basisset is geselecteerd.</span>{% endif %}
      </p>
      {% if section.settings.text != blank %}<div class="pl-redesign-product__description">{{ section.settings.text }}</div>{% endif %}
      {% if template.name == 'collection' %}
        <a class="pl-redesign-image-button pl-redesign-image-button--wide" href="{{ featured_product.url | default: '/products/wat-eten-we-vandaag-basisset' }}">{{ section.settings.button_label | default: 'Bekijk de basisset' }}</a>
      {% elsif featured_product != blank and variant != blank %}
        <product-form-component data-section-id="{{ section.id }}" data-product-id="{{ featured_product.id }}" data-product-url="{{ featured_product.url }}" on:submit="/handleSubmit">
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {% form 'product', featured_product, id: product_form_id, data-type: 'add-to-cart-form' %}
            <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            {% render 'add-to-cart-button', add_to_cart_text: section.settings.button_label, class: 'pl-redesign-image-button pl-redesign-image-button--wide', can_add_to_cart: variant.available, product: featured_product %}
          {% endform %}
        </product-form-component>
      {% else %}
        <a class="pl-redesign-image-button pl-redesign-image-button--wide" href="/products/wat-eten-we-vandaag-basisset">Bekijk de basisset</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Plumae: nieuwe basisset",
  "settings": [
    { "type": "product", "id": "product", "label": "Basisset" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding (leeg = eerste productfoto)" },
    { "type": "text", "id": "label", "label": "Bovenregel", "default": "De basisset" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wat eten we vandaag?" },
    { "type": "richtext", "id": "text", "label": "Korte tekst", "default": "<p>Speel samen en maak van de vraag wat er op tafel komt een gezellig spelmoment.</p>" },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Aan winkelwagen toevoegen" }
  ],
  "presets": [{ "name": "Plumae: nieuwe basisset" }]
}
{% endschema %}
