<section class="pl-redesign-intro" style="--letter-w-d: {{ section.settings.letter_w_d }}px; --letter-x-d: {{ section.settings.letter_x_d }}px; --letter-y-d: {{ section.settings.letter_y_d }}px; --letter-w-m: {{ section.settings.letter_w_m }}px; --letter-x-m: {{ section.settings.letter_x_m }}px; --letter-y-m: {{ section.settings.letter_y_m }}px; --intro-wall-w-d: {{ section.settings.wall_w_d }}px; --intro-wall-x-d: {{ section.settings.wall_x_d }}px; --intro-wall-y-d: {{ section.settings.wall_y_d }}%; --intro-wall-w-m: {{ section.settings.wall_w_m }}px; --intro-wall-x-m: {{ section.settings.wall_x_m }}px; --intro-wall-y-m: {{ section.settings.wall_y_m }}%;">
  <div class="plumae-shell">
    <div class="pl-redesign-intro__heading plumae-reveal">
      <img src="{{ 'stickmanlettern.png' | file_url }}" width="150" height="190" loading="lazy" alt="" aria-hidden="true">
      <h2>Een kaartspel<br><em>maar dan net anders</em></h2>
    </div>
    <div class="pl-redesign-intro__panel plumae-reveal">
      <img class="pl-redesign-intro__stickman" src="{{ 'stickmanmuur.png' | file_url }}" width="190" height="300" loading="lazy" alt="" aria-hidden="true">
      <p><strong>Wat Eten We Vandaag?</strong> is een kaartspel waarmee je samen op een leuke en snelle manier je weekmenu bepaalt. Kies gerechten, gebruik actiekaarten om het menu te veranderen en ontdek via de app direct de recepten en boodschappenlijst.</p>
      <p>Zo verandert de wekelijkse vraag <em>“Wat eten we vandaag?”</em> van een terugkerende discussie in een kort en gezellig spelmoment.</p>
      <ul>
        <li>Discussies over het eten</li>
        <li>Haastig bedenken wat je moet eten</li>
        <li>Geen zin in boodschappen doen</li>
      </ul>
      <a class="pl-redesign-image-button pl-redesign-image-button--small" href="#basisset">Shop nu</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Plumae: intro",
  "settings": [
    { "type": "header", "content": "Figuur bij kop – desktop" },
    { "type": "range", "id": "letter_w_d", "label": "Grootte", "min": 40, "max": 200, "step": 5, "unit": "px", "default": 100 },
    { "type": "range", "id": "letter_x_d", "label": "Afstand vanaf links", "min": -100, "max": 200, "step": 5, "unit": "px", "default": -40 },
    { "type": "range", "id": "letter_y_d", "label": "Afstand vanaf boven", "min": -100, "max": 200, "step": 5, "unit": "px", "default": -30 },
    { "type": "header", "content": "Figuur bij kop – mobiel" },
    { "type": "range", "id": "letter_w_m", "label": "Grootte mobiel", "min": 40, "max": 160, "step": 5, "unit": "px", "default": 75 },
    { "type": "range", "id": "letter_x_m", "label": "Afstand vanaf links mobiel", "min": -100, "max": 200, "step": 5, "unit": "px", "default": -15 },
    { "type": "range", "id": "letter_y_m", "label": "Afstand vanaf boven mobiel", "min": -100, "max": 200, "step": 5, "unit": "px", "default": -25 },
    { "type": "header", "content": "Figuur achter muur – desktop" },
    { "type": "range", "id": "wall_w_d", "label": "Grootte muurfiguur", "min": 40, "max": 200, "step": 5, "unit": "px", "default": 110 },
    { "type": "range", "id": "wall_x_d", "label": "Afstand vanaf rechts", "min": -100, "max": 200, "step": 5, "unit": "px", "default": -70 },
    { "type": "range", "id": "wall_y_d", "label": "Hoogte op tekstvlak", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 20 },
    { "type": "header", "content": "Figuur achter muur – mobiel" },
    { "type": "range", "id": "wall_w_m", "label": "Grootte muurfiguur mobiel", "min": 40, "max": 160, "step": 5, "unit": "px", "default": 70 },
    { "type": "range", "id": "wall_x_m", "label": "Afstand vanaf rechts mobiel", "min": -100, "max": 200, "step": 5, "unit": "px", "default": -25 },
    { "type": "range", "id": "wall_y_m", "label": "Hoogte op tekstvlak mobiel", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 20 }
  ],
  "presets": [{ "name": "Plumae: intro" }]
}
{% endschema %}
