{% assign banner_alt = section.settings.image.alt | default: section.settings.heading %}
<section class="plumae-page-banner" style="--banner-bg: {{ section.settings.background_color }}; --banner-text: {{ section.settings.text_color }}; --banner-height: {{ section.settings.height }}px; --banner-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  {% if section.settings.image != blank %}
    <div class="plumae-page-banner__image">
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '750, 1100, 1600, 2200', sizes: '100vw', alt: banner_alt }}
    </div>
    <div class="plumae-page-banner__overlay"></div>
  {% endif %}
  <div class="plumae-shell plumae-page-banner__content">
    <h1 class="plumae-page-banner__title">{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<div class="plumae-page-banner__text plumae-rte">{{ section.settings.text }}</div>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Plumae: paginabanner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Koptekst", "default": "Paginatitel" },
    { "type": "richtext", "id": "text", "label": "Toelichting" },
    { "type": "image_picker", "id": "image", "label": "Achtergrondfoto" },
    { "type": "color", "id": "background_color", "label": "Achtergrondkleur", "default": "#C35943" },
    { "type": "color", "id": "text_color", "label": "Tekstkleur", "default": "#F1EADA" },
    { "type": "range", "id": "overlay_opacity", "label": "Donkerte over foto", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 35 },
    { "type": "range", "id": "height", "label": "Hoogte", "min": 220, "max": 600, "step": 20, "unit": "px", "default": 320 }
  ],
  "presets": [{ "name": "Plumae: paginabanner" }]
}
{% endschema %}
