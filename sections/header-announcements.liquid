{% liquid
  assign pl_date = 'now' | date: '%Y%m%d' | plus: 0
  assign pl_campaign = ''
  assign pl_message = 'Gratis verzending op de basisset in Nederland en België'

  if pl_date >= 20261108 and pl_date <= 20261125
    assign pl_campaign = 'sinterklaas'
    assign pl_message = 'Cadeau voor het hele gezin • Basisset €19,95 + gratis verzending'
  elsif pl_date >= 20261126 and pl_date <= 20261130
    assign pl_campaign = 'blackfriday'
    assign pl_message = 'Black Friday • Basisset €19,95 + gratis verzending'
  elsif pl_date >= 20261201 and pl_date <= 20261205
    assign pl_campaign = 'sinterklaas'
    assign pl_message = 'Nog iets voor in de zak? • €19,95 + gratis verzending'
  elsif pl_date >= 20261206 and pl_date <= 20261226
    assign pl_campaign = 'christmas'
    assign pl_message = 'Voor onder de kerstboom • €19,95 + gratis verzending'
  elsif pl_date >= 20261227 and pl_date <= 20261231
    assign pl_campaign = 'newyear'
    assign pl_message = 'Op naar 2027 zonder keuzestress • €19,95 + gratis verzending'
  endif
%}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <a class="pl-holiday-announcement" href="/products/wat-eten-we-vandaag-basisset">{{ pl_message }}</a>
</aside>

{% stylesheet %}
  .announcement-bar__campaign { width: 100%; margin: 0; color: #f1eada; text-align: center; font-family: var(--font-subheading--family); font-size: .875rem; line-height: 1; }
  .announcement-bar__regular { width: 100%; }
  .announcement-bar { border-block-end: var(--border-bottom-width) solid var(--color-border); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
